# PostgreSQL connection string (Neon: copy it from the dashboard, keep ?sslmode=require)
DATABASE_URL=postgres://user:password@localhost:5432/whiskers_watch

# Secret for signing login tokens — use a long random string in production
JWT_SECRET=change-me

# Production: serve the built frontend from this folder (the Dockerfile sets it)
# STATIC_DIR=../frontend/dist

# Behind a hosting proxy (Render, Koyeb…): trust X-Forwarded-For for rate limiting
# TRUST_PROXY=true

# Only if the frontend is hosted on another domain: allowed origins, comma-separated
# CORS_ORIGIN=https://whiskers.example.com

# One-click demo sandboxes on the landing page (default: true)
# DEMO_ENABLED=true

# Optional: "Sign in with Google" (OAuth client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Optional: SMTP for weekly email digests
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
